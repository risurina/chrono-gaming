{
  "name": "@chrono/pc-client-tauri",
  "version": "0.1.3",
  "private": true,
  "description": "Chrono PC Client — secure Tauri v2 workstation shell for iCafe management",
  "author": "IZUR IT SOLUTIONS",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "dev:tauri": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:guard": "cargo build -p chrono-guard --release",
    "build:installer": "pnpm build:guard && pnpm build:tauri",
    "build:tauri": "tauri build",
    "preview": "vite preview --port 5174 --strictPort",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@chrono/shared": "workspace:*",
    "@risurina/oikos": "workspace:*",
    "@sentry/react": "^8.47.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-log": "^2.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "9.39.4",
    "globals": "^15.11.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.8"
  }
}
