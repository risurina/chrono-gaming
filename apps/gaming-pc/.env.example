# Chrono PC Client (Tauri) — environment
# Copy to .env and adjust. Read by both Vite (frontend) and the Rust core (dotenv).

# Full device API base URL (must include the /api/v1/device suffix).
# Local API: http://localhost:3001/api/v1/device
VITE_API_BASE_URL='https://chrono.api.izur.com.ph/api/v1/device'

# Sentry DSN for the webview (optional).
# VITE_SENTRY_DSN=

# Sentry DSN for the Rust core / native errors + panics (optional).
# Falls back to VITE_SENTRY_DSN if unset, so one DSN can serve both layers.
# SENTRY_DSN=

# Kiosk lockdown toggle (prod defaults on; dev defaults off — set true to test).
# KIOSK_LOCKDOWN_ENABLED=false

# Operator recovery PIN: no env var. The PIN is verified by the LocalSystem guard
# against a salted PBKDF2 record stored in the ACL'd %ProgramData%\Chrono\recovery.hash.
# Provision it at install time: install-service.ps1 -RecoveryPin "<8+ char PIN>".
