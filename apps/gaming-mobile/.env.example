# Mobile App Environment Variables
# Use EXPO_PUBLIC_ prefix for variables to be available in the app code.

# API origin (the gaming-api server root — NOT a /api/v1 or /portal prefix).
# Local dev: the api subdomain of the app domain so cookies share a registrable
# domain with tenant subdomains (matches apps/gaming-web/.env.example).
EXPO_PUBLIC_API_URL=http://api.localtest.me:8787

# Apex domain tenants live under; subdomains are tenant slugs. Used when resolving
# a scanned venue/station QR host into an x-tenant-slug / x-tenant-host header.
EXPO_PUBLIC_APP_DOMAIN=localtest.me:3000
