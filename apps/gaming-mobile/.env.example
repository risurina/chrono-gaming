# Mobile App Environment Variables
# Use the EXPO_PUBLIC_ prefix for variables that must be available in app code.

# gaming-api base URL — the origin ROOT (no /api/v1, no trailing slash).
# Default when unset: http://api.localtest.me:8787 (a console warning is logged
# on startup when falling back to the default).
EXPO_PUBLIC_API_URL=http://api.localtest.me:8787

# App web domain (host:port) used to build tenant-facing links. Mirrors the
# gaming-web APP_DOMAIN; not required for API calls (tenant context is sent via
# the x-tenant-slug header).
EXPO_PUBLIC_APP_DOMAIN=localtest.me:3000

# Sentry crash reporting (optional).
EXPO_PUBLIC_SENTRY_DSN=
