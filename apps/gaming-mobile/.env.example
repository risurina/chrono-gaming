# Mobile App Environment Variables
# Use the EXPO_PUBLIC_ prefix for variables that must be available in app code.

# Chrono API base URL (versioned root, no trailing slash).
# Default when unset: https://chrono.api.izur.com.ph/api/v1 (a console warning
# is logged on startup when falling back to the default).
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Tenant root domain used to derive the tenant hostname sent via the
# `x-oikos-hostname` header ("{tenantSlug}.{root domain}"). MUST equal the
# chrono-api server's ROOT_DOMAIN or tenant resolution fails.
# Default when unset: chrono.izur.com.ph (startup warning logged on fallback).
EXPO_PUBLIC_TENANT_ROOT_DOMAIN=chrono.izur.com.ph

# Sentry crash reporting (optional).
EXPO_PUBLIC_SENTRY_DSN=
