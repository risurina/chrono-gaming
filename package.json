{
  "name": "chrono-icafe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@chrono/gaming-api\" --filter \"@chrono/gaming-web\" dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @chrono/gaming-api db:generate",
    "db:migrate": "pnpm --filter @chrono/gaming-api db:migrate",
    "db:push": "pnpm --filter @chrono/gaming-api db:push",
    "db:studio": "pnpm --filter @chrono/gaming-api db:studio",
    "db:seed": "pnpm --filter @chrono/gaming-api seed",
    "db:app-role": "pnpm --filter @chrono/gaming-api db:app-role",
    "db:rls:proof": "pnpm --filter @chrono/gaming-api rls:proof",
    "test:e2e": "pnpm --filter @chrono/gaming-api test:e2e"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
